<Window x:Class="Adrt.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adrt settings"
        Width="940" Height="780"
        MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static SystemColors.WindowBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12"
                Background="{x:Static SystemColors.ControlBrush}"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Height="28"
                             Padding="6,3"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock x:Name="SearchHint"
                               Text="Search by setting name or key (Ctrl+F)"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{x:Static SystemColors.GrayTextBrush}"
                               IsHitTestVisible="False" />
                </Grid>

                <Button Grid.Column="1"
                        x:Name="ReloadButton"
                        Content="Reload"
                        Padding="14,4"
                        Margin="0,0,8,0"
                        Click="OnReloadClicked" />
                <Button Grid.Column="2"
                        x:Name="ResetAllButton"
                        Content="Reset all"
                        Padding="14,4"
                        Click="OnResetAllClicked" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="16,6"
                Background="{x:Static SystemColors.ControlBrush}"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           x:Name="PathText"
                           MaxWidth="470"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12">
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
