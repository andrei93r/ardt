<Project>
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
    <!--
      The core is a 1:1 port of the TypeScript model. Keep the source names
      (Float/Single/String/Int/Uint, EventQueue, the drain's DrainAge API) even
      where .NET naming analyzers would rename them; performance suggestions
      for private fields are not actionable in a faithful port.
    -->
    <NoWarn>$(NoWarn);CA1720;CA1711;CA1859;CA1822</NoWarn>
  </PropertyGroup>
</Project>
